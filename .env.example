POSTGRES_DB=capital_markets
POSTGRES_USER=capital
POSTGRES_PASSWORD=capital
DATABASE_URL=postgresql+psycopg://capital:capital@db:5432/capital_markets
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

APP_ENV=development
LOG_LEVEL=INFO
MARKET_DATA_PROVIDER=stooq
MARKET_DATA_TIMEOUT_SECONDS=30
MARKET_DATA_RETRIES=2
DEFAULT_SYMBOLS=AAPL,MSFT,SPY,TSLA,NVDA,JPM

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
